project_name = "retail-agent"
environment  = "dev"

# Frankfurt — nearest cloud regions to Duisburg
aws_region = "eu-central-1"
gcp_region = "europe-west3"

# Set your real GCP project ID before enabling GCP
gcp_project_id = "your-gcp-project-id"

enable_aws = true
enable_gcp = true

# Set to true only after you have a container image in ECR / Artifact Registry
enable_aws_apprunner = false
enable_gcp_cloudrun  = false

# Example: 123456789012.dkr.ecr.eu-central-1.amazonaws.com/retail-agent:latest
container_image = ""

bedrock_model_id  = "anthropic.claude-3-haiku-20240307-v1:0"
vertex_model_name = "gemini-1.5-flash"
llm_provider      = "bedrock"
